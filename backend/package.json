{
  "name": "github-account-linker-api",
  "version": "1.0.0",
  "private": true,
  "description": "Express API that links a GitHub account through OAuth with PKCE and keeps the token server-side",
  "main": "dist/server.js",
  "engines": {
    "node": "^22.22.3"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "tsc && (tsc --watch --preserveWatchOutput & node --env-file-if-exists=.env --watch dist/server.js)",
    "test": "npm run build && node --test tests/*.test.cjs",
    "lint": "eslint .",
    "test:e2e": "npm run build && node --test --test-concurrency=1 tests/e2e/*.e2e.cjs"
  },
  "license": "ISC",
  "dependencies": {
    "axios": "^1.21.0",
    "express": "^5.3.0",
    "mongoose": "^9.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
