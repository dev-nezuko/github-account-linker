# Read by docker compose. Generate the key with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters

# Leave these unset to use the bundled GitHub mock. For a real OAuth app, register the
# callback http://localhost:4200/api/github/callback and set all five values.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
# GITHUB_API_BASE_URL=https://api.github.com
